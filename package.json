    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "build:seed-bundle": "esbuild prisma/seed.ts --bundle --platform=node --outfile=prisma/seed.bundle.cjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
