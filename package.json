    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "prisma": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
