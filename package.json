    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.13.1",
    "postcss": "^8.5.18",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": ">=0.35.0",
