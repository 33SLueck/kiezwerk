# =============================================================================
# KiezWerk Berlin — Demo Showcase (Lück Digital)
# =============================================================================
# Copy to .env:  cp .env.example .env
# NEVER commit .env. All values below are DEMO-only.
# =============================================================================

# --- PostgreSQL & Docker Compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo_local_password_change_me
POSTGRES_DB=kiezwerk_demo
POSTGRES_PORT=5436

DATABASE_URL=postgresql://postgres:demo_local_password_change_me@localhost:5436/kiezwerk_demo?schema=public
DATABASE_URL_DOCKER=postgresql://postgres:demo_local_password_change_me@postgres:5432/kiezwerk_demo?schema=public

PORT=3002
NODE_ENV=development

# --- Uploads (local Docker volume path inside container) ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880

# --- NextAuth (required for /admin) ---
NEXTAUTH_URL=http://localhost:3002
AUTH_SECRET=demo_auth_secret_change_me_not_for_production
AUTH_TRUST_HOST=true
# Protect /admin and /api/admin (recommended: true)
REQUIRE_ADMIN_AUTH=true

# Demo admin credentials (seeded). NOT for production.
ADMIN_EMAIL=demo.admin@kiezwerk.example
ADMIN_PASSWORD=DemoAdmin123!

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_NAME=KiezWerk Berlin

# --- Database bootstrap (local dev) ---
RUN_DB_SEED=true
RUN_DB_ACCEPT_DATA_LOSS=true
